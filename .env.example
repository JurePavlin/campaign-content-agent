# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Values in .env override machine-wide environment variables.
# Model names are the deployment names you chose in Foundry (by default, the model's name).

# --- Claude on Microsoft Foundry (Anthropic Messages API): the writer ---
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_BASE_URL=https://<your-resource>.services.ai.azure.com/anthropic
WRITER_MODEL=claude-haiku-5-5

# --- OpenAI models on Microsoft Foundry (OpenAI-compatible v1 API): checker and embeddings ---
OPENAI_FOUNDRY_API_KEY=
OPENAI_FOUNDRY_BASE_URL=https://<your-resource>.services.ai.azure.com/openai/v1/
CHECKER_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# --- LangSmith tracing ---
# LANGSMITH_API_KEY is already set machine-wide; only set it here to use a different key.
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=campaign-content-agent

# --- Postgres + pgvector (docker compose) ---
DATABASE_URL=postgresql://agent:agent@localhost:5432/campaign_agent
