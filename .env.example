# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Values in .env override machine-wide environment variables.

# --- Microsoft Foundry: one resource, one key, two endpoints ---
# From your Foundry resource: Keys and Endpoint. Replace <your-resource> in both URLs.
FOUNDRY_API_KEY=
FOUNDRY_ANTHROPIC_ENDPOINT=https://<your-resource>.services.ai.azure.com/anthropic
FOUNDRY_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1/
# Deployment names, as you named them when deploying the models.
WRITER_DEPLOYMENT=claude-haiku-5-5
CHECKER_DEPLOYMENT=gpt-6-luna
EMBEDDING_DEPLOYMENT=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# --- LangSmith tracing ---
# LANGSMITH_API_KEY is already set machine-wide; only set it here to use a different key.
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=campaign-content-agent

# --- Postgres + pgvector (docker compose) ---
DATABASE_URL=postgresql://agent:agent@localhost:5432/campaign_agent
