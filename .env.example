# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Values in .env override machine-wide environment variables.

# --- Azure OpenAI in Microsoft Foundry (v1 API) ---
# From your Foundry resource: Keys and Endpoint. Keep the /openai/v1/ suffix.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
# Deployment names, as you named them when deploying the models.
WRITER_DEPLOYMENT=gpt-5.4
CHECKER_DEPLOYMENT=gpt-5.4-mini
EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- LangSmith tracing ---
# LANGSMITH_API_KEY is already set machine-wide; only set it here to use a different key.
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=campaign-content-agent

# --- Postgres + pgvector (docker compose) ---
DATABASE_URL=postgresql://agent:agent@localhost:5432/campaign_agent
